{
  "name": "playwright-ts-enterprise",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "npm ci && playwright install chromium firefox webkit",
    "app": "tsx src/demo/server.ts",
    "test": "playwright test",
    "test:all": "playwright test --project=*",
    "test:ui": "playwright test --project=chromium",
    "test:api": "playwright test --project=api",
    "test:smoke": "playwright test --grep @smoke",
    "test:headed": "playwright test --project=chromium --headed",
    "test:interactive": "playwright test --ui",
    "test:debug": "playwright test --project=chromium --debug",
    "test:visual:update": "playwright test tests/ui/visual.spec.ts --project=chromium --update-snapshots",
    "test:shuffle": "playwright test --shuffle",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run test:integration && npm test && npm run test:bdd",
    "report": "playwright show-report",
    "trace": "playwright show-trace",
    "codegen": "tsx scripts/codegen.ts",
    "mcp": "tsx src/mcp/server.ts",
    "mcp:browser": "node scripts/browser-mcp.mjs",
    "agent:demo": "tsx src/agent/cli.ts --demo",
    "agent": "tsx src/agent/cli.ts",
    "agents:init": "playwright init-agents --loop=vscode --project=chromium",
    "components:setup": "node scripts/components.mjs --setup",
    "test:components": "node scripts/components.mjs",
    "test:bdd": "tsx scripts/cucumber.ts",
    "test:bdd:smoke": "tsx scripts/cucumber.ts --profile smoke",
    "test:bdd:api": "tsx scripts/cucumber.ts --profile api",
    "test:bdd:ui": "tsx scripts/cucumber.ts --profile ui",
    "test:bdd:firefox": "tsx scripts/cucumber.ts --profile firefox",
    "test:bdd:webkit": "tsx scripts/cucumber.ts --profile webkit",
    "test:bdd:headed": "tsx scripts/cucumber.ts --profile headed",
    "test:bdd:dry": "tsx scripts/cucumber.ts --dry-run",
    "codegen:guest": "tsx scripts/codegen.ts --guest",
    "codegen:plan": "tsx scripts/codegen.ts --dry-run",
    "codegen:import": "tsx scripts/import-codegen.ts",
    "codegen:raw": "playwright codegen",
    "test:ui:components": "playwright test tests/ui/components.spec.ts --project=chromium",
    "test:ui:components:all": "playwright test tests/ui/components.spec.ts --project=*",
    "test:bdd:components": "tsx scripts/cucumber.ts --tags @components",
    "test:bdd:components:firefox": "tsx scripts/cucumber.ts --profile firefox --tags @components",
    "test:bdd:components:webkit": "tsx scripts/cucumber.ts --profile webkit --tags @components"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "dotenv": "17.4.2",
    "express": "5.3.0",
    "openai": "7.45.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cucumber/cucumber": "13.3.0",
    "@eslint/js": "10.0.1",
    "@playwright/mcp": "0.0.83",
    "@playwright/test": "1.64.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
